#!/usr/bin/env bash

VERSION="2.7.1"
REPO_URL="${TMUXIFY_REPO_URL:-https://raw.githubusercontent.com/mustafamohsen/tmuxify/main/tmuxify}"
EXAMPLES_ARCHIVE_URL="${TMUXIFY_EXAMPLES_ARCHIVE_URL:-https://github.com/mustafamohsen/tmuxify/archive/refs/heads/main.tar.gz}"
COMPLETIONS_ARCHIVE_URL="${TMUXIFY_COMPLETIONS_ARCHIVE_URL:-$EXAMPLES_ARCHIVE_URL}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
TMUXIFY_CONFIG_DIR="$CONFIG_HOME/tmuxify"
GLOBAL_LAYOUTS_DIR="$TMUXIFY_CONFIG_DIR/layouts"
GLOBAL_EXAMPLES_DIR="$GLOBAL_LAYOUTS_DIR/examples"
GLOBAL_COMPLETIONS_DIR="$TMUXIFY_CONFIG_DIR/completions"
GLOBAL_DEFAULT_CONFIG_FILE="$GLOBAL_LAYOUTS_DIR/default.yml"

CUSTOM_CONFIG=""
ROOT_OVERRIDE=""
LIST_SESSIONS=0
EXPORT_FLAG=0
EXPORT_FILENAME=""
LIST_LAYOUTS=0
COMPLETION_OPTIONS=0
DRY_RUN=0
DETACH=0
RUN_COMMANDS=1
PANE_NAMES_ENABLED=0
PANE_NAMES_BORDER="preserve"
TMP_DIR=""
EXPORT_TEMP_FILE=""
UPDATE_STAGE_FILE=""
SESSION_CREATED=0
CREATED_SESSION_ID=""
SESSION_CREATING=0
SESSION_COMMITTING=0
INTERRUPTED_STATUS=0

info() { printf '%s\n' "ℹ️ $*"; }
success() { printf '%s\n' "✅ $*"; }
warn() { printf '%s\n' "⚠️ $*"; }
die() {
  printf '%s\n' "❌ Error: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: tmuxify [OPTIONS]

Instantly launch customized tmux workspaces from YAML.

Options:
  -v, --version              Show version
  -u, --update               Download and install the latest version safely
  -h, --help                 Show help
  -l, --list                 List active tmux sessions
      --list-layouts         List project and user layout files
  -f, --file LAYOUT_FILE     Use a specific layout file (overrides .tmuxify.yml)
      --root DIR            Use an explicit project root
  -e, --export [FILENAME]    Export current tmux session layout to YAML
      --dry-run              Validate and preview the layout without creating tmux sessions
      --detach               Create the session without attaching or switching clients
      --no-commands          Create panes without running configured commands

Completion metadata:
      --completion-options   Print machine-readable option metadata

Project identity:
  Worktree discovery stops at the nearest .git marker; --root overrides it.
  session.name selects a workspace within the project, not a literal tmux name.
  Actual names include an identity suffix; existing legacy sessions stay untouched.
  --dry-run reports context without inspecting or changing running sessions.

Optional pane names (YAML configuration, not CLI flags):
  Set session.pane_names.enabled: true and add name to leaf panes (tmux 3.2+).
  session.pane_names.border: preserve (default), top, or bottom.
  preserve keeps your border settings; top/bottom display stable pane labels.
  Without pane-name opt-in, the tmux 2.1 baseline remains supported.

Security note:
  Layout commands are shell commands. Review layouts from untrusted projects first,
  or use --dry-run / --no-commands.
EOF
}

cleanup() {
  if [ "$SESSION_CREATED" -eq 1 ]; then
    tmux kill-session -t "$CREATED_SESSION_ID" 2>/dev/null || true
    SESSION_CREATED=0
  fi
  if [ -n "$EXPORT_TEMP_FILE" ]; then
    rm -f "$EXPORT_TEMP_FILE"
  fi
  if [ -n "$UPDATE_STAGE_FILE" ]; then
    rm -f "$UPDATE_STAGE_FILE"
  fi
  if [ -n "$TMP_DIR" ] && [ -d "$TMP_DIR" ]; then
    rm -rf "$TMP_DIR"
  fi
}
handle_signal() {
  # A signal may arrive after tmux created the session but before ownership was
  # recorded. Finish that one transition before exiting and rolling back.
  if [ "$SESSION_CREATING" -eq 1 ] || [ "$SESSION_COMMITTING" -eq 1 ]; then
    INTERRUPTED_STATUS="$1"
  else
    exit "$1"
  fi
}
trap cleanup EXIT
trap 'handle_signal 129' HUP
trap 'handle_signal 130' INT
trap 'handle_signal 143' TERM

while [ $# -gt 0 ]; do
  case "$1" in
    --version|-v)
      echo "tmuxify version $VERSION"
      exit 0
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --update|-u)
      UPDATE_REQUESTED=1
      ;;
    --list|-l)
      LIST_SESSIONS=1
      ;;
    --root)
      [ -z "$ROOT_OVERRIDE" ] || die "--root may only be supplied once."
      if [ -z "${2:-}" ] || [ "${2#-}" != "$2" ]; then
        die "Missing directory after --root."
      fi
      ROOT_OVERRIDE="$2"
      shift
      ;;
    --list-layouts)
      LIST_LAYOUTS=1
      ;;
    --completion-options)
      COMPLETION_OPTIONS=1
      ;;
    --file|-f)
      if [ -n "${2:-}" ] && [ "${2#-}" = "$2" ]; then
        CUSTOM_CONFIG="$2"
        shift
      else
        die "Missing file path after --file/-f flag"
      fi
      ;;
    --export|-e)
      EXPORT_FLAG=1
      if [ -n "${2:-}" ] && [ "${2#-}" = "$2" ]; then
        EXPORT_FILENAME="$2"
        shift
      fi
      ;;
    --dry-run)
      DRY_RUN=1
      ;;
    --detach)
      DETACH=1
      ;;
    --no-commands)
      RUN_COMMANDS=0
      ;;
    *)
      echo "❌ Error: Unknown option: $1" >&2
      echo "Run 'tmuxify --help' for usage information." >&2
      exit 1
      ;;
  esac
  shift
done

print_completion_options() {
  cat <<'EOF'
--version|-v
--update|-u
--help|-h
--list|-l
--list-layouts
--file|-f:file
--root:directory
--export|-e:file
--dry-run
--detach
--no-commands
--completion-options
EOF
}

path_exists() { [ -e "$1" ] || [ -L "$1" ]; }

canonical_directory() {
  local physical
  # The sentinel preserves trailing newlines so unsupported paths cannot alias.
  physical=$(unset CDPATH; cd -P -- "$1" && env pwd -P && printf '.') || die "Cannot resolve project directory."
  physical=${physical%.}
  physical=${physical%$'\n'}
  case "$physical" in *$'\n'*) die "Project paths must not contain control characters." ;; esac
  if printf '%s' "$physical" | LC_ALL=C grep -q '[[:cntrl:]]'; then
    die "Project paths must not contain control characters."
  fi
  printf '%s\n' "$physical"
}

resolve_project_context() {
  local directory ceiling
  INVOCATION_DIR=$(canonical_directory .) || exit 1
  WORKDIR="$INVOCATION_DIR"
  ROOT_SOURCE="invocation directory"
  if [ -n "$ROOT_OVERRIDE" ]; then
    WORKDIR=$(canonical_directory "$ROOT_OVERRIDE") || exit 1
    ROOT_SOURCE="explicit --root"
    DEFAULT_CONFIG_FILE="${WORKDIR%/}/.tmuxify.yml"
    return
  fi
  directory="$INVOCATION_DIR"
  ceiling=""
  while :; do
    if [ ! -r "$directory" ] || [ ! -x "$directory" ]; then
      die "Cannot inspect project ancestors; use --root."
    fi
    if path_exists "$directory/.git"; then
      [ -d "$directory/.git" ] || [ -f "$directory/.git" ] || [ -L "$directory/.git" ] ||
        die "Unsupported .git marker; use --root to select a project explicitly."
      ceiling="$directory"
      break
    fi
    [ "$directory" != / ] || break
    directory=${directory%/*}; directory=${directory:-/}
  done
  if [ -n "$ceiling" ]; then
    WORKDIR="$ceiling"
    ROOT_SOURCE="worktree root"
    directory="$INVOCATION_DIR"
    while :; do
      if path_exists "$directory/.tmuxify.yml"; then
        WORKDIR="$directory"
        ROOT_SOURCE="project layout within worktree"
        break
      fi
      [ "$directory" != "$ceiling" ] || break
      directory=${directory%/*}; directory=${directory:-/}
    done
  fi
  DEFAULT_CONFIG_FILE="${WORKDIR%/}/.tmuxify.yml"
}

list_layouts() {
  local project_layout found
  project_layout="$DEFAULT_CONFIG_FILE"
  found=0

  printf 'Project root: %s\n' "$WORKDIR"
  printf 'Available tmuxify layouts:\n'
  if [ -f "$project_layout" ]; then
    printf '  project     %s\n' "$project_layout"
    found=1
  fi
  if [ -f "$GLOBAL_DEFAULT_CONFIG_FILE" ]; then
    printf '  default     %s\n' "$GLOBAL_DEFAULT_CONFIG_FILE"
    found=1
  fi
  if [ -d "$GLOBAL_EXAMPLES_DIR" ]; then
    while IFS= read -r layout_file; do
      printf '  example     %s\n' "$layout_file"
      found=1
    done < <(find "$GLOBAL_EXAMPLES_DIR" -type f \( -name '*.yml' -o -name '*.yaml' \) -print | sort)
  fi

  if [ "$found" -eq 0 ]; then
    printf '  none found\n'
    printf '\nRun tmuxify --update to download bundled examples into %s\n' "$GLOBAL_EXAMPLES_DIR"
  fi
}

install_completions() {
  local archive temp_extract completions_dir
  command -v tar >/dev/null || { warn "tar is required to install completions; skipping completions."; return 0; }

  archive="$1"
  temp_extract="$2"
  mkdir -p "$temp_extract" || die "Failed to prepare completions directory."

  if ! tar -xzf "$archive" -C "$temp_extract" 2>/dev/null; then
    warn "Could not extract completions from update archive; leaving existing completions unchanged."
    return 0
  fi
  completions_dir=$(dirname "$(find "$temp_extract" -path '*/completions/tmuxify.bash' -type f | head -n 1)")
  if [ -z "$completions_dir" ] || [ "$completions_dir" = "." ]; then
    warn "Could not find completions in update archive; leaving existing completions unchanged."
    return 0
  fi

  rm -rf "$GLOBAL_COMPLETIONS_DIR"
  mkdir -p "$GLOBAL_COMPLETIONS_DIR" || die "Failed to create completions directory: $GLOBAL_COMPLETIONS_DIR"
  cp -R "$completions_dir/." "$GLOBAL_COMPLETIONS_DIR/" || die "Failed to install completions."
  success "Completions installed to $GLOBAL_COMPLETIONS_DIR"
  info "Bash: source $GLOBAL_COMPLETIONS_DIR/tmuxify.bash"
  info "Zsh: add $GLOBAL_COMPLETIONS_DIR to fpath and run compinit"
}

install_example_layouts() {
  local archive temp_extract layouts_dir
  command -v tar >/dev/null || { warn "tar is required to install example layouts; skipping examples."; return 0; }

  mkdir -p "$GLOBAL_LAYOUTS_DIR" || die "Failed to create config layouts directory: $GLOBAL_LAYOUTS_DIR"
  archive="$1"
  temp_extract="$2"
  mkdir -p "$temp_extract" || die "Failed to prepare example layout directory."

  if ! tar -xzf "$archive" -C "$temp_extract" 2>/dev/null; then
    warn "Could not extract example layouts from update archive; leaving existing examples unchanged."
    return 0
  fi
  layouts_dir=$(find "$temp_extract" -path '*/examples/layouts' -type d | head -n 1)
  if [ -z "$layouts_dir" ]; then
    warn "Could not find example layouts in update archive; leaving existing examples unchanged."
    return 0
  fi

  rm -rf "$GLOBAL_EXAMPLES_DIR"
  mkdir -p "$GLOBAL_EXAMPLES_DIR" || die "Failed to create examples directory: $GLOBAL_EXAMPLES_DIR"
  cp -R "$layouts_dir/." "$GLOBAL_EXAMPLES_DIR/" || die "Failed to install example layouts."
  success "Example layouts installed to $GLOBAL_EXAMPLES_DIR"
}

safe_update() {
  local temp_dir temp_file examples_archive completions_archive first_line candidate_version SCRIPT_PATH INSTALL_DIR INSTALL_PATH backup
  command -v curl >/dev/null || die "curl is required for --update."

  info "Downloading latest tmuxify..."
  temp_dir=$(mktemp -d 2>/dev/null || mktemp -d -t tmuxify-update) || die "Failed to create temporary directory."
  TMP_DIR="$temp_dir"
  temp_file="$temp_dir/tmuxify"
  examples_archive="$temp_dir/tmuxify-examples.tar.gz"
  completions_archive="$temp_dir/tmuxify-completions.tar.gz"

  if ! curl -fsSL "$REPO_URL" -o "$temp_file"; then
    rm -rf "$temp_dir"
    die "Failed to download the latest version from $REPO_URL"
  fi

  [ -s "$temp_file" ] || { rm -rf "$temp_dir"; die "Downloaded file is empty. Update failed."; }
  first_line=$(sed -n '1p' "$temp_file")
  case "$first_line" in
    '#!/usr/bin/env bash'|'#!/bin/bash') ;;
    *) rm -rf "$temp_dir"; die "Downloaded candidate must be a Bash script. Update aborted." ;;
  esac

  if ! bash -n "$temp_file"; then
    rm -rf "$temp_dir"
    die "Downloaded candidate has invalid Bash syntax. Update aborted."
  fi
  if [ "$(grep -c '^VERSION=' "$temp_file")" != 1 ] || ! grep -Eq '^VERSION="[0-9]+\.[0-9]+\.[0-9]+"$' "$temp_file"; then
    rm -rf "$temp_dir"
    die "Downloaded candidate must declare one numeric major.minor.patch VERSION. Update aborted."
  fi
  candidate_version=$(sed -n 's/^VERSION="\([0-9.]*\)"$/\1/p' "$temp_file")
  info "Downloading latest example layouts..."
  if ! curl -fsSL "$EXAMPLES_ARCHIVE_URL" -o "$examples_archive"; then
    warn "Failed to download example layouts from $EXAMPLES_ARCHIVE_URL; continuing with script update."
    examples_archive=""
  fi
  info "Downloading latest completions..."
  if ! curl -fsSL "$COMPLETIONS_ARCHIVE_URL" -o "$completions_archive"; then
    warn "Failed to download completions from $COMPLETIONS_ARCHIVE_URL; continuing with script update."
    completions_archive=""
  fi

  SCRIPT_PATH=$(command -v "$0" 2>/dev/null || printf '%s' "$0")
  INSTALL_DIR=$(dirname "$SCRIPT_PATH")
  INSTALL_PATH="$INSTALL_DIR/$(basename "$SCRIPT_PATH")"

  if [ ! -w "$INSTALL_DIR" ] || { [ -e "$INSTALL_PATH" ] && [ ! -w "$INSTALL_PATH" ]; }; then
    rm -rf "$temp_dir"
    die "Insufficient permissions to update $INSTALL_PATH. Re-run your package manager update, or install manually after reviewing the release. tmuxify no longer escalates with sudo automatically."
  fi

  # Stage alongside the install so the final rename stays on one filesystem.
  # Set permissions before publishing; a chmod failure must not damage the install.
  UPDATE_STAGE_FILE=$(mktemp "$INSTALL_DIR/.tmuxify-update.XXXXXX") || die "Failed to stage update beside $INSTALL_PATH."
  if ! cp -p "$temp_file" "$UPDATE_STAGE_FILE" || ! chmod +x "$UPDATE_STAGE_FILE"; then
    die "Failed to prepare executable update."
  fi
  backup=""
  if [ -e "$INSTALL_PATH" ]; then
    backup=$(mktemp "$INSTALL_DIR/.tmuxify-backup.XXXXXX") || die "Failed to prepare update backup."
    cp -p "$INSTALL_PATH" "$backup" || { rm -f "$backup"; die "Failed to create update backup."; }
  fi

  if mv "$UPDATE_STAGE_FILE" "$INSTALL_PATH"; then
    UPDATE_STAGE_FILE=""
    [ -n "$backup" ] && rm -f "$backup"
    mkdir -p "$TMUXIFY_CONFIG_DIR" "$GLOBAL_LAYOUTS_DIR" "$GLOBAL_COMPLETIONS_DIR" || { rm -rf "$temp_dir"; die "Failed to create tmuxify config directories."; }
    if [ -n "$examples_archive" ]; then
      install_example_layouts "$examples_archive" "$temp_dir/examples"
    fi
    if [ -n "$completions_archive" ]; then
      install_completions "$completions_archive" "$temp_dir/completions"
    fi
    rm -rf "$temp_dir"
    success "tmuxify updated successfully to version $candidate_version"
    exit 0
  fi

  if [ -n "$backup" ]; then
    if mv "$backup" "$INSTALL_PATH"; then
      die "Failed to replace installed script; previous version restored."
    fi
    die "Failed to replace installed script and restore it; recovery backup retained at $backup. Restore it manually."
  fi
  die "Failed to replace installed script."
}

if [ -n "$ROOT_OVERRIDE" ] && { [ "${UPDATE_REQUESTED:-0}" -eq 1 ] || [ "$LIST_SESSIONS" -eq 1 ] || [ "$EXPORT_FLAG" -eq 1 ] || [ "$COMPLETION_OPTIONS" -eq 1 ]; }; then
  die "--root only applies to workspace launch, --dry-run, and --list-layouts."
fi

if [ "$LIST_SESSIONS" -eq 1 ]; then
  command -v tmux >/dev/null || die "tmux is required but not found."
  echo "Active tmux sessions:"
  tmux list-sessions || echo "No active tmux sessions found."
  exit 0
fi

if [ "${UPDATE_REQUESTED:-0}" -eq 1 ]; then
  safe_update
fi

if [ "${COMPLETION_OPTIONS:-0}" -eq 1 ]; then
  print_completion_options
  exit 0
fi

if [ "$LIST_LAYOUTS" -eq 1 ]; then
  resolve_project_context
  list_layouts
  exit 0
fi

command -v yq >/dev/null || die "yq v4 is required but not found. Please install it (https://github.com/mikefarah/yq)."
YQ_VERSION=$(yq --version 2>/dev/null || true)
case "$YQ_VERSION" in
  *version\ v4*|*version\ 4*) ;;
  *) die "Mike Farah yq v4 is required. Detected: ${YQ_VERSION:-unknown}" ;;
esac

if [ "$DRY_RUN" -eq 0 ]; then
  command -v tmux >/dev/null || die "tmux is required but not found. Please install it (https://github.com/tmux/tmux)."
fi

select_configuration() {
  resolve_project_context
  CONFIG_SOURCE="built-in default"
  CONFIG_FILE=""
  if [ -n "$CUSTOM_CONFIG" ]; then
    case "$CUSTOM_CONFIG" in
      /*) CONFIG_SOURCE="$CUSTOM_CONFIG" ;;
      *) CONFIG_SOURCE="$INVOCATION_DIR/$CUSTOM_CONFIG" ;;
    esac
    info "Using custom layout file: $CONFIG_SOURCE"
  elif path_exists "$DEFAULT_CONFIG_FILE"; then
    CONFIG_SOURCE="$DEFAULT_CONFIG_FILE"
  elif path_exists "$GLOBAL_DEFAULT_CONFIG_FILE"; then
    CONFIG_SOURCE="$GLOBAL_DEFAULT_CONFIG_FILE"
    info "Using global default layout file: $CONFIG_SOURCE"
  else
    return
  fi
  if [ ! -f "$CONFIG_SOURCE" ] || [ ! -r "$CONFIG_SOURCE" ]; then
    die "Cannot read layout file: $CONFIG_SOURCE"
  fi
  init_tmp_dir
  CONFIG_FILE="$TMP_DIR/layout.yml"
  cp -- "$CONFIG_SOURCE" "$CONFIG_FILE" || die "Failed to snapshot layout: $CONFIG_SOURCE"
}

sanitize_name() {
  printf '%s' "$1" | sed 's/\./_/g; s/[^a-zA-Z0-9_-][^a-zA-Z0-9_-]*/_/g; s/^_//; s/_$//'
}

derive_workspace_identity() {
  local session_type name_type project_label workspace_label checksum roundtrip
  session_type=$(yq -r '.session | tag' "$CONFIG_FILE") || die "Cannot read session configuration."
  case "$session_type" in '!!map'|'!!null') ;; *) die "session must be a mapping or null." ;; esac
  name_type=$(yq -r '.session.name | tag' "$CONFIG_FILE") || die "Cannot read workspace name."
  case "$name_type" in '!!str'|'!!null') ;; *) die "session.name must be a string or null." ;; esac
  if [ "$name_type" = '!!str' ] && [ "$(yq -r '.session.name | test("[\x00-\x1f\x7f-\x9f]")' "$CONFIG_FILE")" != false ]; then
    die "session.name must not contain control characters."
  fi
  WORKSPACE_NAME=$(yq -r '.session.name // ""' "$CONFIG_FILE") || die "Cannot read workspace name."
  WORKSPACE_KIND=default
  [ -z "$WORKSPACE_NAME" ] || WORKSPACE_KIND=named
  WORKSPACE_IDENTITY=$(IDENTITY_ROOT="$WORKDIR" IDENTITY_KIND="$WORKSPACE_KIND" IDENTITY_NAME="$WORKSPACE_NAME" \
    yq -n -o=json -I=0 '["tmuxify-workspace-v1", strenv(IDENTITY_ROOT), strenv(IDENTITY_KIND), strenv(IDENTITY_NAME)]') || die "Cannot encode workspace identity."
  roundtrip=$(printf '%s' "$WORKSPACE_IDENTITY" | yq -p=json -r '.[1]') || die "Cannot decode project root."
  [ "$roundtrip" = "$WORKDIR" ] || die "Project root must be valid UTF-8."
  if [ "$(printf '%s' "$WORKSPACE_IDENTITY" | yq -p=json -r '.[1] | test("[\x00-\x1f\x7f-\x9f]")')" != false ]; then
    die "Project paths must not contain control characters."
  fi
  project_label=$(sanitize_name "${WORKDIR##*/}" | LC_ALL=C cut -c1-24)
  [ "$WORKDIR" != / ] || project_label=root
  project_label=${project_label:-project}
  workspace_label=default
  if [ "$WORKSPACE_KIND" = named ]; then
    workspace_label=$(sanitize_name "$WORKSPACE_NAME" | LC_ALL=C cut -c1-24)
    workspace_label=${workspace_label:-workspace}
    legacy_session_name=$(sanitize_name "$WORKSPACE_NAME")
  else
    legacy_session_name=$(sanitize_name "${WORKDIR##*/}")
    [ "$WORKDIR" != / ] || legacy_session_name=root
    legacy_session_name=${legacy_session_name:-tmuxify_session}
  fi
  checksum=$(printf '%s\0' tmuxify-workspace-v1 "$WORKDIR" "$WORKSPACE_KIND" "$WORKSPACE_NAME" | cksum) || die "cksum is required for workspace naming."
  printf -v session_name '%s--%s--%08x' "$project_label" "$workspace_label" "${checksum%% *}"
}

# Normalize only the supported identity shape. Missing/malformed metadata is not
# evidence of ownership. All comparisons use full fields, never the CRC suffix.
normalize_identity() {
  printf '%s' "$1" | yq -p=json -e -o=json -I=0 'select(
    tag == "!!seq" and length == 4 and .[0] == "tmuxify-workspace-v1" and
    (.[1] | tag) == "!!str" and (.[1] | test("^/")) and
    (.[1] | test("[\x00-\x1f\x7f-\x9f]") | not) and
    (.[3] | tag) == "!!str" and (.[3] | test("[\x00-\x1f\x7f-\x9f]") | not) and
    ((.[2] == "default" and .[3] == "") or (.[2] == "named" and .[3] != ""))
  )' 2>/dev/null
}

session_option() {
  # Without -g/-A, show-options reads only session-local options (also on 2.1).
  tmux show-options -qv -t "$1" "$2" || die "Failed to read workspace metadata for $1."
}

resolve_workspace_session() {
  local native_session metadata normalized actual_name state matches occupied error
  MATCHING_SESSION_ID=""
  LEGACY_SESSION_NAME=""
  matches=0
  occupied=0
  if ! LC_ALL=C tmux list-sessions -F '#{session_id}' > "$TMP_DIR/sessions" 2> "$TMP_DIR/inventory-error"; then
    error=$(< "$TMP_DIR/inventory-error")
    case "$error" in
      'no server running on '*|'error connecting to '*' (No such file or directory)'|'error connecting to '*' (Connection refused)') return ;;
      *) die "Cannot inspect tmux sessions: $error" ;;
    esac
  fi
  while IFS= read -r native_session; do
    metadata=$(session_option "$native_session" @tmuxify_workspace_identity) || exit 1
    normalized=""
    [ -z "$metadata" ] || normalized=$(normalize_identity "$metadata" || true)
    if [ "$normalized" = "$WORKSPACE_IDENTITY" ]; then
      matches=$((matches + 1))
      MATCHING_SESSION_ID="$native_session"
    fi
    actual_name=$(tmux display-message -p -t "$native_session" '#{session_name}') || die "Cannot inspect session $native_session."
    [ -n "$actual_name" ] || die "Session $native_session disappeared during workspace lookup."
    [ "$actual_name" != "$session_name" ] || occupied=1
    if [ -z "$metadata" ] && [ "$actual_name" = "$legacy_session_name" ]; then
      LEGACY_SESSION_NAME="$actual_name"
    fi
  done < "$TMP_DIR/sessions"
  [ "$matches" -le 1 ] || die "Multiple sessions claim this workspace identity; inspect them with tmux before retrying."
  if [ "$matches" -eq 1 ]; then
    # Keep tmux's output newline plus a sentinel: command substitution must not
    # turn an invalid value such as "ready\n" into the exact readiness token.
    state=$(session_option "$MATCHING_SESSION_ID" @tmuxify_workspace_state && printf '.') || exit 1
    [ "$state" = $'ready\n.' ] || die "Workspace $MATCHING_SESSION_ID is building or has invalid readiness; inspect it or retry later."
  elif [ "$occupied" -eq 1 ]; then
    die "Session name '$session_name' is occupied without a matching identity. Nothing was adopted or changed."
  fi
}

commit_workspace() {
  local state
  SESSION_COMMITTING=1
  if tmux set-option -t "$CREATED_SESSION_ID" @tmuxify_workspace_state ready; then
    SESSION_CREATED=0
  else
    # A failed acknowledgement does not prove the publication failed. Preserve
    # a ready session, or one whose commit outcome cannot be inspected safely.
    if state=$(tmux show-options -qv -t "$CREATED_SESSION_ID" @tmuxify_workspace_state && printf '.'); then
      [ "$state" != $'ready\n.' ] || SESSION_CREATED=0
    else
      SESSION_CREATED=0
    fi
    SESSION_COMMITTING=0
    die "Failed to confirm workspace readiness; inspect session $CREATED_SESSION_ID if retained."
  fi
  SESSION_COMMITTING=0
  [ "$INTERRUPTED_STATUS" -eq 0 ] || exit "$INTERRUPTED_STATUS"
}

init_tmp_dir() {
  if [ -z "$TMP_DIR" ]; then
    TMP_DIR=$(mktemp -d 2>/dev/null || mktemp -d -t tmuxify) || die "Failed to create temporary directory."
    : > "$TMP_DIR/pane_id_map"
    : > "$TMP_DIR/build_panes"
    : > "$TMP_DIR/seen_ids"
    : > "$TMP_DIR/window_id_map"
    : > "$TMP_DIR/configured_commands"
    : > "$TMP_DIR/named_pane_paths"
  fi
}

record_seen_id() {
  local pane_id pane_path
  init_tmp_dir
  pane_id="$1"
  pane_path="$2"
  if [ -z "$pane_id" ] || [ "$pane_id" = "null" ]; then return 0; fi
  if ! printf '%s' "$pane_id" | grep -Eq '^[A-Za-z][A-Za-z0-9_-]*$'; then
    die "Invalid pane id '$pane_id' at $pane_path. Use letters, numbers, underscores, and dashes; start with a letter."
  fi
  if grep -Fqx "$pane_id" "$TMP_DIR/seen_ids"; then
    die "Duplicate pane id '$pane_id' at $pane_path. Pane IDs must be unique."
  fi
  printf '%s\n' "$pane_id" >> "$TMP_DIR/seen_ids"
}

map_pane_id() {
  local pane_id tmux_pane
  init_tmp_dir
  pane_id="$1"
  tmux_pane="$2"
  if [ -z "$pane_id" ] || [ "$pane_id" = "null" ]; then return 0; fi
  printf '%s\t%s\n' "$pane_id" "$tmux_pane" >> "$TMP_DIR/pane_id_map"
}

lookup_pane_id() {
  local pane_id
  pane_id="$1"
  [ -n "$TMP_DIR" ] || return 0
  awk -F '\t' -v id="$pane_id" '$1 == id { print $2; found=1 } END { exit found ? 0 : 1 }' "$TMP_DIR/pane_id_map" 2>/dev/null
}

record_build_pane() {
  init_tmp_dir
  printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$TMP_DIR/build_panes"
}

lookup_build_pane() {
  awk -F '\t' -v path="$1" -v idx="$2" '$1 == path && $2 == idx { print $3; found=1 } END { exit found ? 0 : 1 }' "$TMP_DIR/build_panes"
}

validate_size() {
  local size size_path
  size="$1"
  size_path="$2"
  if [ -z "$size" ] || [ "$size" = "null" ]; then return 0; fi
  if ! printf '%s' "$size" | grep -Eq '^[1-9][0-9]?%$|^100%$'; then
    die "Invalid size '$size' at $size_path. Use 1% through 100%."
  fi
}

# Only an explicit YAML boolean true activates the new schema. Everything else
# retains the historical treatment of these keys as ignored metadata.
configure_pane_names() {
  local enabled valid_border
  enabled=$(yq -r '.session | select(tag == "!!map") | .pane_names | select(tag == "!!map") | .enabled | select(tag == "!!bool")' "$CONFIG_FILE")
  [ "$enabled" = "true" ] || return 0
  PANE_NAMES_ENABLED=1
  if [ "$(yq -r '.session.pane_names | has("border")' "$CONFIG_FILE")" = "true" ]; then
    # Compare the original scalar before command substitution strips newlines.
    valid_border=$(yq -r '.session.pane_names.border | ((tag == "!!str") and (. == "preserve" or . == "top" or . == "bottom"))' "$CONFIG_FILE")
    [ "$valid_border" = "true" ] || die "session.pane_names.border must be preserve, top, or bottom."
    PANE_NAMES_BORDER=$(yq -r '.session.pane_names.border' "$CONFIG_FILE")
  fi
}

validate_pane_name() {
  local path name_type invalid_name
  path="$1"
  [ "$PANE_NAMES_ENABLED" -eq 1 ] || return 0
  [ "$(yq -r "$path | has(\"name\")" "$CONFIG_FILE")" = "true" ] || return 0
  [ "$2" != "true" ] || die "Pane name at $path.name is only allowed on leaf panes, not layout containers."
  name_type=$(yq -r "$path.name | type" "$CONFIG_FILE")
  [ "$name_type" = "!!str" ] || die "Pane name at $path.name must be a non-empty single-line string without control characters."
  # Validate before shell extraction, which would discard trailing newlines.
  invalid_name=$(yq -r "$path.name | ((length == 0) or test(\"[\\x00-\\x1f\\x7f-\\x9f]\"))" "$CONFIG_FILE")
  [ "$invalid_name" = "false" ] || die "Pane name at $path.name must be a non-empty single-line string without control characters."
  printf '%s\n' "$path" >> "$TMP_DIR/named_pane_paths"
}

validate_layout_node() {
  local path node_type layout_type splits_type count i item_path item_type size has_nested has_command pane_id command_type
  path="$1"
  node_type=$(yq -r "$path | type" "$CONFIG_FILE")
  [ "$node_type" = "!!map" ] || die "Expected layout object at $path."
  validate_pane_name "$path" true

  layout_type=$(yq -r "$path.type // \"\"" "$CONFIG_FILE")
  case "$layout_type" in
    horizontal|vertical) ;;
    *) die "Invalid layout type '$layout_type' at $path. Must be 'horizontal' or 'vertical'." ;;
  esac

  splits_type=$(yq -r "$path.splits | type" "$CONFIG_FILE")
  [ "$splits_type" = "!!seq" ] || die "Expected non-empty splits array at $path.splits."
  count=$(yq -r "$path.splits | length" "$CONFIG_FILE")
  [ "$count" -gt 0 ] 2>/dev/null || die "Expected non-empty splits array at $path.splits."

  i=0
  while [ "$i" -lt "$count" ]; do
    item_path="$path.splits[$i]"
    item_type=$(yq -r "$item_path | type" "$CONFIG_FILE")
    [ "$item_type" = "!!map" ] || die "Expected object at $item_path."

    size=$(yq -r "$item_path.size // \"\"" "$CONFIG_FILE")
    validate_size "$size" "$item_path.size"

    has_nested=$(yq -r "$item_path | has(\"type\")" "$CONFIG_FILE")
    has_command=$(yq -r "$item_path | has(\"command\")" "$CONFIG_FILE")
    pane_id=$(yq -r "$item_path.id // \"\"" "$CONFIG_FILE")
    record_seen_id "$pane_id" "$item_path.id"
    validate_pane_name "$item_path" "$has_nested"

    if [ "$has_nested" = "true" ]; then
      validate_layout_node "$item_path"
    else
      if [ -z "$pane_id" ] && [ "$has_command" != "true" ]; then
        if [ "$PANE_NAMES_ENABLED" -eq 0 ] || [ "$(yq -r "$item_path | has(\"name\")" "$CONFIG_FILE")" != "true" ]; then
          warn "Pane at $item_path has no id or command; it will be created as an empty shell."
        fi
      fi
    fi

    if [ "$has_command" = "true" ]; then
      command_type=$(yq -r "$item_path.command | type" "$CONFIG_FILE")
      [ "$command_type" = "!!str" ] || die "Expected string command at $item_path.command."
    fi

    i=$((i + 1))
  done
}

validate_config() {
  local has_layout has_windows windows_type window_count window_id window_name window_name_type i window_path
  [ -f "$CONFIG_FILE" ] || return 0
  if ! yq eval '.' "$CONFIG_FILE" >/dev/null 2>&1; then
    die "Invalid YAML syntax in $CONFIG_FILE"
  fi
  configure_pane_names
  has_layout=$(yq -r 'has("layout")' "$CONFIG_FILE")
  has_windows=$(yq -r 'has("windows")' "$CONFIG_FILE")
  [ "$has_layout" != "true" ] || [ "$has_windows" != "true" ] || die "Configuration cannot contain both layout and windows."
  [ "$has_layout" = "true" ] || [ "$has_windows" = "true" ] || die "Configuration must contain either a layout object or a windows collection."

  init_tmp_dir
  : > "$TMP_DIR/seen_ids"
  if [ "$has_windows" = "true" ]; then
    windows_type=$(yq -r '.windows | type' "$CONFIG_FILE")
    [ "$windows_type" = "!!seq" ] || die "windows must be a non-empty sequence."
    window_count=$(yq -r '.windows | length' "$CONFIG_FILE")
    [ "$window_count" -gt 0 ] 2>/dev/null || die "windows must be a non-empty sequence."
    i=0
    while [ "$i" -lt "$window_count" ]; do
      window_path=".windows[$i]"
      window_id=$(yq -r "$window_path.id // \"\"" "$CONFIG_FILE")
      [ -n "$window_id" ] || die "Missing required window id at $window_path.id."
      if ! printf '%s' "$window_id" | grep -Eq '^[A-Za-z][A-Za-z0-9_-]*$'; then
        die "Invalid window id '$window_id' at $window_path.id. Use letters, numbers, underscores, and dashes; start with a letter."
      fi
      if grep -Fqx "$window_id" "$TMP_DIR/seen_ids"; then
        die "Duplicate window or pane id '$window_id' at $window_path.id. IDs must be unique across the session."
      fi
      printf '%s\n' "$window_id" >> "$TMP_DIR/seen_ids"
      window_name_type=$(yq -r "$window_path.name | type" "$CONFIG_FILE")
      window_name=$(yq -r "$window_path.name // \"\"" "$CONFIG_FILE")
      if [ "$window_name_type" != "!!str" ] || [ -z "$window_name" ]; then
        die "Window name at $window_path.name must be a non-empty string."
      fi
      validate_layout_node "$window_path.layout"
      i=$((i + 1))
    done
  else
    layout_root_type=$(yq -r '.layout | type' "$CONFIG_FILE")
    [ "$layout_root_type" = "!!map" ] || die "Missing required layout object in $CONFIG_FILE"
    validate_layout_node ".layout"
  fi

  initial_focus=$(yq -r '.session.initial_focus // ""' "$CONFIG_FILE")
  if [ -n "$initial_focus" ] && [ "$initial_focus" != "null" ]; then
    if ! grep -Fqx "$initial_focus" "$TMP_DIR/seen_ids"; then
      if [ "$has_windows" = "true" ]; then
        die "session.initial_focus '$initial_focus' does not match any window or pane id."
      fi
      die "session.initial_focus '$initial_focus' does not match any pane id."
    fi
  fi
}

print_plan_node() {
  local path indent layout_type count i child_indent item_path pane_id size has_nested has_command label command_text
  path="$1"
  indent="$2"
  layout_type=$(yq -r "$path.type" "$CONFIG_FILE")
  count=$(yq -r "$path.splits | length" "$CONFIG_FILE")
  printf '%s- layout: %s (%s splits)\n' "$indent" "$layout_type" "$count"
  i=0
  child_indent="  $indent"
  while [ "$i" -lt "$count" ]; do
    item_path="$path.splits[$i]"
    pane_id=$(yq -r "$item_path.id // \"\"" "$CONFIG_FILE")
    size=$(yq -r "$item_path.size // \"auto\"" "$CONFIG_FILE")
    has_nested=$(yq -r "$item_path | has(\"type\")" "$CONFIG_FILE")
    has_command=$(yq -r "$item_path | has(\"command\")" "$CONFIG_FILE")
    label="pane"
    [ "$has_nested" = "true" ] && label="nested"
    printf '%s- %s id=%s size=%s' "$child_indent" "$label" "${pane_id:-none}" "$size"
    if [ "$PANE_NAMES_ENABLED" -eq 1 ] && [ "$(yq -r "$item_path | has(\"name\")" "$CONFIG_FILE")" = "true" ]; then
      printf ' name=%s' "$(yaml_scalar "$(yq -r "$item_path.name" "$CONFIG_FILE")")"
    fi
    if [ "$has_command" = "true" ]; then
      command_text=$(yq -r "$item_path.command" "$CONFIG_FILE")
      printf ' command=%s' "$command_text"
    fi
    printf '\n'
    [ "$has_nested" = "true" ] && print_plan_node "$item_path" "    $indent"
    i=$((i + 1))
  done
}

yaml_scalar() {
  YAML_SCALAR_VALUE="$1" yq -n -o=json '. = strenv(YAML_SCALAR_VALUE)'
}

export_session() {
  local current_session safe_session export_dir export_base temp_export active_pane window_count window_number native_window window_name pane_count pane_number native_pane focus_id
  local current_id metadata identity export_name identity_option
  local -a export_target
  export_target=()
  [ -z "${TMUX_PANE:-}" ] || export_target=(-t "$TMUX_PANE")
  command -v tmux >/dev/null || die "tmux is required for --export."
  [ -n "$TMUX" ] || die "Not currently in a tmux session. Please run this inside tmux."

  current_session=$(tmux display-message -p "${export_target[@]}" '#{session_name}') || die "Failed to read current tmux session."
  current_id=$(tmux display-message -p "${export_target[@]}" '#{session_id}') || die "Failed to identify current tmux session."
  if [ -z "$current_session" ] || [ -z "$current_id" ]; then
    die "Current tmux session disappeared."
  fi
  # Without -v, an explicitly empty local option still includes its name.
  # Absence permits legacy export; presence always requires a valid identity.
  identity_option=$(tmux show-options -q -t "$current_id" @tmuxify_workspace_identity) || die "Failed to read workspace metadata for $current_id."
  export_name=$(yaml_scalar "$current_session")
  if [ -n "$identity_option" ]; then
    metadata=$(session_option "$current_id" @tmuxify_workspace_identity) || exit 1
    identity=$(normalize_identity "$metadata") || die "Cannot export malformed or unsupported workspace identity."
    if [ "$(printf '%s' "$identity" | yq -p=json -r '.[2]')" = default ]; then
      export_name=null
    else
      export_name=$(printf '%s' "$identity" | yq -p=json -o=json -I=0 '.[3]') || die "Cannot export workspace name."
    fi
  fi
  if [ -z "$EXPORT_FILENAME" ]; then
    safe_session=$(sanitize_name "$current_session")
    [ -n "$safe_session" ] || safe_session="tmuxify"
    EXPORT_FILENAME="./${safe_session}-layout.yml"
  fi

  if [ -L "$EXPORT_FILENAME" ]; then
    die "Refusing to overwrite symlink: $EXPORT_FILENAME"
  fi
  if [ -e "$EXPORT_FILENAME" ]; then
    die "Refusing to overwrite existing file: $EXPORT_FILENAME"
  fi

  umask 077
  export_dir=$(dirname "$EXPORT_FILENAME")
  export_base=$(basename "$EXPORT_FILENAME")
  [ -d "$export_dir" ] || die "Export directory does not exist: $export_dir"
  temp_export=$(mktemp "$export_dir/.${export_base}.tmp.XXXXXX") || die "Failed to create temporary export file."
  EXPORT_TEMP_FILE="$temp_export"
  info "Exporting current session '$current_session' layout to $EXPORT_FILENAME..."

  active_pane=$(tmux display-message -p -t "$current_id" '#{pane_id}') || die "Failed to read active pane."
  init_tmp_dir
  tmux list-windows -t "$current_id" -F '#{window_id}' > "$TMP_DIR/export_windows" || die "Failed to read window list."
  window_count=$(wc -l < "$TMP_DIR/export_windows" | tr -d ' ')
  [ "$window_count" -gt 0 ] 2>/dev/null || die "Current session has no windows."

  focus_id=""
  window_number=1
  while IFS= read -r native_window; do
    tmux display-message -p -t "$native_window" '#{window_name}' > "$TMP_DIR/export_window_name_$window_number" || die "Failed to read window name."
    tmux list-panes -t "$native_window" -F '#{pane_id}' > "$TMP_DIR/export_window_panes_$window_number" || die "Failed to read window panes."
    pane_number=1
    while IFS= read -r native_pane; do
      if [ "$native_pane" = "$active_pane" ]; then
        focus_id="window${window_number}_pane${pane_number}"
      fi
      pane_number=$((pane_number + 1))
    done < "$TMP_DIR/export_window_panes_$window_number"
    window_number=$((window_number + 1))
  done < "$TMP_DIR/export_windows"
  [ -n "$focus_id" ] || die "Failed to identify active pane in current session."

  {
    printf '# Simplified starter layout exported by tmuxify\n'
    printf '# Generated on %s\n\n' "$(date)"
    printf 'session:\n  name: %s\n  initial_focus: %s\n\n' "$export_name" "$focus_id"
    printf 'windows:\n'
    window_number=1
    while IFS= read -r native_window; do
      window_name=$(cat "$TMP_DIR/export_window_name_$window_number")
      pane_count=$(wc -l < "$TMP_DIR/export_window_panes_$window_number" | tr -d ' ')
      printf '  - id: window%s\n' "$window_number"
      printf '    name: %s\n' "$(yaml_scalar "$window_name")"
      printf '    layout:\n      type: horizontal\n      splits:\n'
      pane_number=1
      while [ "$pane_number" -le "$pane_count" ]; do
        printf '        - id: window%s_pane%s\n' "$window_number" "$pane_number"
        pane_number=$((pane_number + 1))
      done
      window_number=$((window_number + 1))
    done < "$TMP_DIR/export_windows"
    printf '\n# Note: This is a simplified representation of your current session.\n'
    printf '# Review pane sizes and add commands before using it; exact geometry, shell state, and history are not exported.\n'
  } > "$temp_export" || die "Failed to write export file."

  mv "$temp_export" "$EXPORT_FILENAME" || die "Failed to finalize export file."
  EXPORT_TEMP_FILE=""
  success "Layout exported to $EXPORT_FILENAME"
  info "You can use this file with: tmuxify --file $EXPORT_FILENAME"
  exit 0
}

if [ "$EXPORT_FLAG" -eq 1 ]; then
  export_session
fi

select_configuration

# Use the same preview, construction, and command controls for the built-in layout.
if [ ! -f "$CONFIG_FILE" ]; then
  init_tmp_dir
  CONFIG_FILE="$TMP_DIR/default.yml"
  cat > "$CONFIG_FILE" <<'YAML'
session:
  initial_focus: editor
layout:
  type: horizontal
  splits:
    - id: editor
      size: 50%
      command: "if command -v nvim >/dev/null 2>&1; then nvim .; else printf '%s\\n' 'Install Neovim or use this shell for your editor.'; fi"
    - type: vertical
      size: 50%
      splits:
        - id: assistant
          size: 50%
          command: "echo 'Top Right Pane (e.g., aider)'"
        - type: horizontal
          size: 50%
          splits:
            - id: git
              size: 50%
              command: "echo 'Bottom Left (e.g., lazygit)'"
            - id: terminal
              size: 50%
              command: "clear && echo 'Bottom Right (terminal)'"
YAML
  info "Using default 4-pane workspace."
fi

validate_config

derive_workspace_identity

if [ "$DRY_RUN" -eq 1 ]; then
  success "Configuration is valid."
  printf 'Project root: %s\nRoot source: %s\nLayout source: %s\n' "$WORKDIR" "$ROOT_SOURCE" "$CONFIG_SOURCE"
  printf 'Workspace: %s' "$WORKSPACE_KIND"
  [ "$WORKSPACE_KIND" != named ] || printf ' %s' "$(yaml_scalar "$WORKSPACE_NAME")"
  printf '\nProposed tmux session: %s\n' "$session_name"
  printf 'Existing sessions are not inspected; a matching runtime session will be reused unchanged.\n'
  if [ "$PANE_NAMES_ENABLED" -eq 1 ]; then
    printf 'Pane names: enabled (border: %s; requires tmux 3.2+)\n' "$PANE_NAMES_BORDER"
  fi
  printf 'Layout plan:\n'
  if [ "$(yq -r 'has("windows")' "$CONFIG_FILE")" = "true" ]; then
    window_count=$(yq -r '.windows | length' "$CONFIG_FILE")
    i=0
    while [ "$i" -lt "$window_count" ]; do
      printf '  Window: %s (%s)\n' "$(yq -r ".windows[$i].id" "$CONFIG_FILE")" "$(yq -r ".windows[$i].name" "$CONFIG_FILE")"
      print_plan_node ".windows[$i].layout" "    "
      i=$((i + 1))
    done
  else
    print_plan_node ".layout" "  "
  fi
  [ "$RUN_COMMANDS" -eq 1 ] && printf 'Commands: would run configured pane commands.\n' || printf 'Commands: disabled by --no-commands.\n'
  exit 0
fi

TMUX_VERSION=$(tmux -V | sed -E 's/tmux[^0-9]*([.0-9]+).*/\1/')
TMUX_MAJOR=$(echo "$TMUX_VERSION" | cut -d. -f1)
TMUX_MINOR=$(echo "$TMUX_VERSION" | cut -d. -f2)
if [ "$TMUX_MAJOR" -lt 2 ] || { [ "$TMUX_MAJOR" -eq 2 ] && [ "$TMUX_MINOR" -lt 1 ]; }; then
  die "tmuxify requires tmux version 2.1 or newer. Detected version: $TMUX_VERSION"
fi

attach_or_switch() {
  local target_session actual_name quoted_target
  target_session="$1"
  actual_name=$(tmux display-message -p -t "$target_session" '#{session_name}') || die "Workspace disappeared before attachment."
  [ -n "$actual_name" ] || die "Workspace disappeared before attachment."
  SESSION_CREATED=0
  cleanup
  if [ "$DETACH" -eq 1 ]; then
    printf -v quoted_target '%q' "=$actual_name"
    success "Session '$actual_name' is ready for project $WORKDIR. Attach with: tmux attach -t $quoted_target"
    exit 0
  fi
  if [ -n "$TMUX" ]; then
    exec tmux switch-client -t "$target_session"
  fi
  exec tmux attach -t "$target_session"
}

resolve_workspace_session
if [ -n "$MATCHING_SESSION_ID" ]; then
  info "Reusing workspace $MATCHING_SESSION_ID unchanged."
  attach_or_switch "$MATCHING_SESSION_ID"
fi
if [ -n "$LEGACY_SESSION_NAME" ]; then
  warn "Unmanaged session '$LEGACY_SESSION_NAME' was left untouched. New workspace commands may duplicate running programs; use --no-commands to inspect first."
fi

# Pane-local options need 3.0, but literal style escaping also needs tmux 3.2.
# The old baseline still applies without opt-in; reuse above needs neither.
if [ "$PANE_NAMES_ENABLED" -eq 1 ] && { [ "$TMUX_MAJOR" -lt 3 ] || { [ "$TMUX_MAJOR" -eq 3 ] && [ "$TMUX_MINOR" -lt 2 ]; }; }; then
  die "Pane names require tmux 3.2 or newer. Upgrade tmux or remove session.pane_names.enabled."
fi

tmux_or_die() {
  if ! "$@"; then
    die "Command failed: $*"
  fi
}

# Allocate the parent extent once, reserving separators and at least one cell
# per child. Normalize oversubscribed (or fully explicit) ratios to fit.
allocate_pane_sizes() {
  yq -r "$1.splits[].size // \"auto\"" "$CONFIG_FILE" | awk -v extent="$2" '
    { n++; if ($0 == "auto") { automatic[n]=1; autos++ }
      else { weights[n]=$0+0; explicit+=$0 } }
    END {
      remaining=extent-(n-1)
      if (remaining < n) exit 1
      share=(autos && explicit < 100) ? (100-explicit)/autos : 0
      for (i=1; i<=n; i++) {
        if (automatic[i]) weights[i]=share
        total+=weights[i]
      }
      # Clamp undersized children, then redistribute among the others.
      do {
        changed=0
        for (i=1; i<=n; i++) {
          if (!fixed[i] && (!weights[i] || remaining*weights[i]/total < 1)) {
            cells[i]=1; fixed[i]=1; remaining--; total-=weights[i]; changed=1
          }
        }
      } while (changed)
      cumulative=0; allocated=0
      for (i=1; i<=n; i++) {
        if (!fixed[i]) {
          cumulative+=weights[i]
          next_total=int(remaining*cumulative/total+0.000001)
          cells[i]=next_total-allocated; allocated=next_total
        }
        printf "%s%d", (i == 1 ? "" : " "), cells[i]
      }
      printf "\n"
    }'
}

configure_pane_name_border() {
  local layout_path native_window
  [ "$PANE_NAMES_ENABLED" -eq 1 ] || return 0
  [ "$PANE_NAMES_BORDER" != "preserve" ] || return 0
  layout_path="$1"
  native_window="$2"
  # Only validated leaf paths count, not names inside ignored custom metadata.
  grep -Fq "$layout_path.splits[" "$TMP_DIR/named_pane_paths" || return 0
  # Set the border before splitting so sizing sees the actual available space.
  tmux_or_die tmux set-option -w -t "$native_window" pane-border-status "$PANE_NAMES_BORDER"
  tmux_or_die tmux set-option -w -t "$native_window" pane-border-format '#{?#{!=:#{@tmuxify_pane_name},},#{@tmuxify_pane_label},#{pane_title}}'
}

set_configured_pane_name() {
  local item_path pane_target pane_name
  [ "$PANE_NAMES_ENABLED" -eq 1 ] || return 0
  item_path="$1"
  pane_target="$2"
  [ "$(yq -r "$item_path | has(\"name\")" "$CONFIG_FILE")" = "true" ] || return 0
  pane_name=$(yq -r "$item_path.name" "$CONFIG_FILE")
  # tmux also parses a trailing semicolon in an argv value as a separator.
  case "$pane_name" in *';') pane_name="${pane_name%;}\\;" ;; esac
  tmux_or_die tmux set-option -p -t "$pane_target" @tmuxify_pane_name "$pane_name"
  # Formats are not recursively expanded. Escape hashes as well so tmux's
  # subsequent style renderer treats #[...] as text, not styling directives.
  tmux_or_die tmux set-option -p -t "$pane_target" @tmuxify_pane_label "${pane_name//#/##}"
}

queue_configured_command() {
  [ "$RUN_COMMANDS" -eq 0 ] && return 0
  printf '%s\t%s\n' "$1" "$2" >> "$TMP_DIR/configured_commands"
}

dispatch_configured_commands() {
  local pane_target item_path pane_command
  [ "$RUN_COMMANDS" -eq 0 ] && return 0
  [ ! -s "$TMP_DIR/configured_commands" ] && return 0
  info "Running commands from $CONFIG_SOURCE. Use --dry-run to preview or --no-commands to create panes only."
  while IFS=$'\t' read -r pane_target item_path; do
    pane_command=$(yq -r "$item_path.command" "$CONFIG_FILE")
    tmux_or_die tmux send-keys -t "$pane_target" "$pane_command" C-m
  done < "$TMP_DIR/configured_commands"
}

build_layout() {
  local layout_path container_pane layout_type count i prev_pane item_path current_pane split_flag has_nested has_command pane_id extent size_plan remaining
  local -a pane_sizes
  layout_path="$1"
  container_pane="$2"
  layout_type=$(yq -r "$layout_path.type" "$CONFIG_FILE")
  count=$(yq -r "$layout_path.splits | length" "$CONFIG_FILE")
  if [ "$layout_type" = "horizontal" ]; then
    split_flag="-h"
    extent=$(tmux display-message -p -t "$container_pane" '#{pane_width}') || die "Failed to read parent width."
  else
    split_flag="-v"
    extent=$(tmux display-message -p -t "$container_pane" '#{pane_height}') || die "Failed to read parent height."
  fi
  size_plan=$(allocate_pane_sizes "$layout_path" "$extent") || die "Not enough room for $count panes at $layout_path. Enlarge the tmux window or reduce the splits."
  read -r -a pane_sizes <<< "$size_plan"
  remaining="$extent"

  i=0
  prev_pane=""
  while [ "$i" -lt "$count" ]; do
    item_path="$layout_path.splits[$i]"
    if [ "$i" -eq 0 ]; then
      current_pane="$container_pane"
    else
      remaining=$((remaining - pane_sizes[i - 1] - 1))
      current_pane=$(tmux split-window "$split_flag" -l "$remaining" -t "$prev_pane" -c "$TMUX_WORKDIR" -P -F '#{pane_id}') ||
        die "Failed to split pane $prev_pane while building $layout_path."
    fi
    record_build_pane "$layout_path" "$i" "$current_pane"
    prev_pane="$current_pane"
    i=$((i + 1))
  done

  i=0
  while [ "$i" -lt "$count" ]; do
    item_path="$layout_path.splits[$i]"
    current_pane=$(lookup_build_pane "$layout_path" "$i")
    has_nested=$(yq -r "$item_path | has(\"type\")" "$CONFIG_FILE")
    has_command=$(yq -r "$item_path | has(\"command\")" "$CONFIG_FILE")
    pane_id=$(yq -r "$item_path.id // \"\"" "$CONFIG_FILE")

    if [ -n "$pane_id" ] && [ "$pane_id" != "null" ]; then
      map_pane_id "$pane_id" "$current_pane"
    fi
    if [ "$has_nested" = "true" ]; then
      build_layout "$item_path" "$current_pane"
    else
      set_configured_pane_name "$item_path" "$current_pane"
    fi
    if [ "$has_command" = "true" ]; then
      queue_configured_command "$current_pane" "$item_path"
    fi
    i=$((i + 1))
  done
}

# Escape tmux's argv separator without changing the canonical identity root.
TMUX_WORKDIR="$WORKDIR"
case "$TMUX_WORKDIR" in *';') TMUX_WORKDIR="${TMUX_WORKDIR%;}\\;" ;; esac

echo "🚀 Creating new session: $session_name"

# reset runtime maps after validation
: > "$TMP_DIR/pane_id_map"
: > "$TMP_DIR/build_panes"

SESSION_CREATING=1
if CREATED_SESSION_ID=$(tmux new-session -d -s "$session_name" -c "$TMUX_WORKDIR" -P -F '#{session_id}'); then
  SESSION_CREATED=1
else
  SESSION_CREATING=0
  [ "$INTERRUPTED_STATUS" -eq 0 ] || exit "$INTERRUPTED_STATUS"
  resolve_workspace_session
  if [ -n "$MATCHING_SESSION_ID" ]; then
    attach_or_switch "$MATCHING_SESSION_ID"
  fi
  die "Failed to create session '$session_name'; another launch may be building it. Retry later."
fi
SESSION_CREATING=0
[ "$INTERRUPTED_STATUS" -eq 0 ] || exit "$INTERRUPTED_STATUS"
tmux_or_die tmux set-option -t "$CREATED_SESSION_ID" @tmuxify_workspace_identity "$WORKSPACE_IDENTITY"
tmux_or_die tmux set-option -t "$CREATED_SESSION_ID" @tmuxify_workspace_state building
if [ "$(session_option "$CREATED_SESSION_ID" @tmuxify_workspace_identity)" != "$WORKSPACE_IDENTITY" ] ||
  [ "$(session_option "$CREATED_SESSION_ID" @tmuxify_workspace_state && printf '.')" != $'building\n.' ]; then
  die "Failed to verify new workspace metadata."
fi
info "Building layout from $CONFIG_SOURCE..."
tmux_or_die tmux set-window-option -t "$CREATED_SESSION_ID:" aggressive-resize on
root_pane=$(tmux display-message -t "$CREATED_SESSION_ID:" -p '#{pane_id}') || die "Failed to identify initial pane."
first_pane="$root_pane"
if [ "$(yq -r 'has("windows")' "$CONFIG_FILE")" = "true" ]; then
  window_count=$(yq -r '.windows | length' "$CONFIG_FILE")
  i=0
  while [ "$i" -lt "$window_count" ]; do
    window_id=$(yq -r ".windows[$i].id" "$CONFIG_FILE")
    window_name=$(yq -r ".windows[$i].name" "$CONFIG_FILE")
    if [ "$i" -eq 0 ]; then
      window_pane="$root_pane"
      native_window=$(tmux display-message -t "$window_pane" -p '#{window_id}') || die "Failed to identify initial window."
      tmux_or_die tmux rename-window -t "$native_window" "$window_name"
    else
      window_result=$(tmux new-window -d -t "$CREATED_SESSION_ID:" -c "$TMUX_WORKDIR" -n "$window_name" -P -F '#{window_id} #{pane_id}') ||
        die "Failed to create configured window '$window_id'."
      native_window=${window_result%% *}
      window_pane=${window_result#* }
    fi
    printf '%s\t%s\t%s\n' "$window_id" "$native_window" "$window_pane" >> "$TMP_DIR/window_id_map"
    tmux_or_die tmux set-window-option -t "$native_window" aggressive-resize on
    configure_pane_name_border ".windows[$i].layout" "$native_window"
    build_layout ".windows[$i].layout" "$window_pane"
    i=$((i + 1))
  done
else
  configure_pane_name_border ".layout" "$root_pane"
  build_layout ".layout" "$root_pane"
fi

dispatch_configured_commands
initial_focus=$(yq -r '.session.initial_focus // ""' "$CONFIG_FILE")
focus_pane=""
focus_window=""
if [ -n "$initial_focus" ] && [ "$initial_focus" != "null" ]; then
  focus_pane=$(lookup_pane_id "$initial_focus" || true)
  if [ -n "$focus_pane" ]; then
    focus_window=$(tmux display-message -t "$focus_pane" -p '#{window_id}') || die "Failed to identify focus window."
    info "Setting initial focus to pane ID '$initial_focus'."
  else
    focus_record=$(awk -F '\t' -v id="$initial_focus" '$1 == id { print $2 "\t" $3; exit }' "$TMP_DIR/window_id_map")
    focus_window=${focus_record%%$'\t'*}
    focus_pane=${focus_record#*$'\t'}
    info "Setting initial focus to window ID '$initial_focus'."
  fi
else
  focus_pane="$first_pane"
  focus_window=$(tmux display-message -t "$focus_pane" -p '#{window_id}') || die "Failed to identify first window."
  info "Setting initial focus to first pane."
fi
tmux_or_die tmux select-window -t "$focus_window"
tmux_or_die tmux select-pane -t "$focus_pane"

commit_workspace
success "Session '$session_name' created successfully."
attach_or_switch "$CREATED_SESSION_ID"

#compdef tmuxify
# zsh completion for tmuxify

_tmuxify_completion_options() {
  tmuxify --completion-options 2>/dev/null
}

_tmuxify() {
  local -a specs
  local line opt aliases kind desc
  specs=()

  while IFS= read -r line; do
    aliases=${line%%:*}
    kind=${line#*:}
    [[ $kind == $line ]] && kind=""
    desc="tmuxify option"
    # Brace expressions built inside strings are not expanded by zsh.
    for opt in "${(@s:|:)aliases}"; do
      if [[ $kind == file ]]; then
        specs+=("${opt}[${desc}]:layout file:_files")
      else
        specs+=("${opt}[${desc}]")
      fi
    done
  done < <(_tmuxify_completion_options)

  _arguments -s $specs
}

_tmuxify "$@"
